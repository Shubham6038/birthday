<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday! 🎂✨</title>
    <!-- Tailwind CSS for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Sacramento&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
            background: linear-gradient(135deg, #fbcfe8 0%, #fed7aa 50%, #fef08a 100%);
            min-height: 100vh;
        }
        .script-font {
            font-family: 'Sacramento', cursive;
        }
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(3deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
        .floating {
            animation: float 4s ease-in-out infinite;
        }
        .balloon {
            position: absolute;
            bottom: -150px;
            width: 50px;
            height: 65px;
            border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
            animation: rise 10s infinite linear;
            z-index: 1;
        }
        .balloon::after {
            content: "";
            position: absolute;
            bottom: -12px;
            left: 22px;
            width: 2px;
            height: 15px;
            background-color: rgba(0,0,0,0.2);
        }
        @keyframes rise {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            100% { transform: translateY(-110vh) scale(1); opacity: 0; }
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center p-4 relative">

    <!-- Background Floating Balloons Generated via JS -->
    <div id="balloon-container" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

    <!-- Main Card Container -->
    <div class="relative z-10 max-w-lg w-full bg-white/80 backdrop-blur-md rounded-3xl shadow-2xl p-8 text-center border border-white/50 my-8">
        
        <!-- Header / Emoji Badge -->
        <div class="inline-block bg-pink-100 text-pink-600 px-4 py-1.5 rounded-full text-sm font-semibold mb-4 shadow-sm">
            🎉 A Special Day for a Special Person 🎉
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-2">
            Happy Birthday <span class="script-font text-pink-600 text-6xl block">Bestie! ✨</span>
        </h1>

        <!-- Cute Illustration or GIF / Emoji icon -->
        <div class="my-6 flex justify-center items-center">
            <div class="w-28 h-28 bg-pink-50 rounded-full flex items-center justify-center text-6xl shadow-inner floating">
                🧸💖
            </div>
        </div>

        <!-- Emotional / Cute Note -->
        <div class="bg-pink-50/70 p-5 rounded-2xl border border-pink-100 text-gray-700 text-sm md:text-base leading-relaxed mb-8 shadow-sm">
            <p class="font-semibold text-pink-600 mb-1">A Little Note For You:</p>
            "I just wanted to remind you how much joy, laughter, and brightness you bring into everyone's life around you. Thank you for being such an incredible person. Sorry for all my silly mistakes and arguments, but you know you mean the absolute world to me! Have the sweetest birthday ever! 🥳🎂"
        </div>

        <!-- Interactive Question Section -->
        <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4" id="question-text">
                Do you forgive me for all my naughtiness &amp; love my surprise? 🥰
            </h2>
            
            <div id="btn-group" class="flex items-center justify-center gap-4 relative h-16">
                <!-- Yes Button -->
                <button id="yes-btn" onclick="celebrateSuccess()" class="bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold py-3 px-8 rounded-full shadow-lg transform transition hover:scale-105 active:scale-95 cursor-pointer">
                    YES, Absolutely! 💖
                </button>

                <!-- No Button (Playfully dodges!) -->
                <button id="no-btn" onmouseover="moveButton()" ontouchstart="moveButton()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-3 px-8 rounded-full shadow transition cursor-pointer absolute right-8">
                    No 🙈
                </button>
            </div>
        </div>

        <!-- Success Message Hidden Box -->
        <div id="success-box" class="hidden mt-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl animate-bounce">
            <p class="font-bold text-lg">Yay! Best decision ever! 🎉✨</p>
            <p class="text-sm">Sending you virtual hugs and unlimited treats! 🍰🎈</p>
        </div>

        <!-- Audio toggle button -->
        <div class="mt-6 pt-4 border-t border-gray-200 flex justify-center items-center gap-3">
            <button onclick="toggleMusic()" id="music-btn" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-4 py-2 rounded-full font-medium transition flex items-center gap-2">
                🎵 Play Celebration Sound
            </button>
        </div>

    </div>

    <script>
        // Array of pleasant soft pastel balloon colors
        const colors = ['#f43f5e', '#ec4899', '#d946ef', '#8b5cf6', '#3b82f6', '#10b981', '#f59e0b'];
        const container = document.getElementById('balloon-container');

        // Create floating background balloons dynamically
        function createBalloon() {
            const balloon = document.createElement('div');
            balloon.classList.add('balloon');
            const color = colors[Math.floor(Math.random() * colors.length)];
            balloon.style.backgroundColor = color;
            
            // Random positioning and sizes
            const leftPos = Math.random() * 100;
            balloon.style.left = leftPos + 'vw';
            
            const animDuration = Math.random() * 5 + 7; // Between 7s to 12s
            balloon.style.animationDuration = animDuration + 's';
            
            const sizeScale = Math.random() * 0.4 + 0.8;
            balloon.style.transform = `scale(${sizeScale})`;

            container.appendChild(balloon);

            // Remove balloon element after animation finishes to prevent clutter
            setTimeout(() => {
                balloon.remove();
            }, animDuration * 1000);
        }

        // Spawn balloons periodically
        setInterval(createBalloon, 800);

        // Playful No button evasion logic
        let dodgeCount = 0;
        const noMessages = ["No 🙈", "Are you sure? 🥺", "Think again! 💭", "Pretty please? 🌸", "Don't click this! 🚫", "You have no choice! 😉"];
        
        function moveButton() {
            const noBtn = document.getElementById('no-btn');
            const btnGroup = document.getElementById('btn-group');
            
            // Calculate random offset within bounds
            const maxX = btnGroup.clientWidth - noBtn.clientWidth - 20;
            const maxY = 80;
            
            const randomX = Math.random() * maxX - (maxX / 2);
            const randomY = (Math.random() - 0.5) * maxY;

            noBtn.style.transform = `translate(${randomX}px, ${randomY}px)`;
            
            dodgeCount = (dodgeCount + 1) % noMessages.length;
            noBtn.innerText = noMessages[dodgeCount];
        }

        // Celebrate success action when 'Yes' is clicked
        function celebrateSuccess() {
            // Trigger confetti explosion
            confetti({
                particleCount: 150,
                spread: 80,
                origin: { y: 0.6 }
            });

            // Show success message container
            document.getElementById('success-box').classList.remove('hidden');
            document.getElementById('question-text').innerText = "Thank you for being my favorite person! ❤️";
            
            // Hide the button group to finalize
            document.getElementById('btn-group').style.display = 'none';

            // Extra continuous confetti bursts
            setTimeout(() => {
                confetti({
                    particleCount: 100,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 }
                });
            }, 250);
            setTimeout(() => {
                confetti({
                    particleCount: 100,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 }
                });
            }, 400);
        }

        // Web Audio API simple happy chime sound generator (No external audio file dependency)
        let audioCtx = null;
        function playChime() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const notes = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88, 523.25]; // C major scale
            notes.forEach((freq, index) => {
                setTimeout(() => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.value = freq;
                    
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.6);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.6);
                }, index * 120);
            });
        }

        let musicPlaying = false;
        function toggleMusic() {
            const musicBtn = document.getElementById('music-btn');
            playChime();
            musicBtn.innerText = "🎵 Playing Chimes... ✨";
            setTimeout(() => {
                musicBtn.innerText = "🎵 Play Celebration Sound";
            }, 2500);
        }

        // Initial welcome confetti blast
        window.onload = function() {
            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.8 }
                });
            }, 500);
        };
    </script>
</body>
</html>
